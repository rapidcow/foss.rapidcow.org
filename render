#!/usr/bin/env perl
# HAVE: render
# NEED: ${B}/MY/option.mk
#
# (Note that we do not "NEED" MY/config.mk; doing so
# would declare an undesirable dependency edge that
# undermines the very point of separating these two.
#
# We do depend on it to be very clear; it's just that
# we don't need to re-render stuff when it changes.)
#
# render - Template Toolkit webpage renderer
#
# To invoke this, add to your Makefile.in (or whatever
# you set your "R" path to):
#
#    resource/location.html: render
#       cd -- $A && ${^X} render -B $B \
#          -- $a/${.IMPSRC} $B/$b/${.TARGET}
#
# (Multiple files are okay!)
#
# GenLib is used solely for implementing [% locate PATH %].
# If you prefer not to use it, simply remove the module
# import line and exclude it from %v.  The script works
# fine without it. ;)
#
# More information about Template Toolkit here:
# https://template-toolkit.org/
#
use utf8;
use 5.008;
use strict;
use warnings;

use Encode ();
use RdKw::I18N::CodeSets ();
use RdKw::L10N::TextDomain ':module' => 'RdKw::WwW::SiteConf::L10N';

use Getopt::Long qw( GetOptions );
use RdKw::WwW::GenGenLib 0.0100 qw(
	read_deps load_state
	norm_dep subs_dep uproot );
use RdKw::WwW::GenLib 0.0203 qw( locate );
use Template;
use RdKw::WwW::GenGenLib::Template::Provider;
use Digest::SHA;
use File::Spec;


my $cs = RdKw::I18N::CodeSets->new();
# Command-line arguments are decoded via the
# argv codeset, though this may be altered by
# the SITECONF_CODESETS and -C flags, so we
# must parse them now.
$cs->parse_from_env('SITECONF_CODESETS', prog => $0);
my $offset = $cs->parse_from_argv(\@ARGV, prog => $0);

# Parsing is complete; we can publish them for
# everyone else.
RdKw::I18N::CodeSets->locale($cs);
$cs->initstd(stderr => Encode::FB_PERLQQ());
my $prog = $cs->un_argv($0, { check => Encode::FB_PERLQQ(), prog => $0 });
@ARGV = $cs->un_argv(@ARGV, { start => 1 + $offset, prog => $prog });

Getopt::Long::Configure(qw( bundling no_ignore_case ));
my $B = '.';
GetOptions(
	'B=s' => \$B,
	# Reject misplaced -C arguments
	'C:s' => sub { die $cs->diag("%#q: %s\n", $prog, __("too late to -C now.")); },
)
# The usage may be altered, so we only translate the "usage:" part.
	or die $cs->diag(__("usage: %s"), $cs->diag("%#q %s\n",
		$prog => '[-B dir] apath bpath'));
# HEY!  The usage is `./render apath bpath', which is two arguments.
@ARGV == 2 or die "$prog: " . __("need exactly two arguments") . "\n";
my ($apath, $bpath) = @ARGV;

# Load configuration parameters and build options,
# so we can expose them to the template.
my %S = load_state($B);
my ($D, $O) = @S{qw( config option )};

#
# Find ourselves from the dependency graph declarations.
# This pattern is purely symbolic, though we also accept
# literal spelling, since some people like to treat ${a}
# as a predefined constant (like how ${A} is).
#
my %I = read_deps($apath);
defined $I{HAVE} or die "E: " . $cs->diag(__("%q: HAVE declaration not found"), $apath) . "\n";
# relapath doesn't do well with the leading slash,
# though people may have a habit of including it...
(my $target = do {
	my ($name, $norm, $real);
	# Try symbolic prefix
	if (defined ($name = uproot('${a}',
		$norm = norm_dep($I{HAVE}))))
	{
		subs_dep($D, $name);
	}
	# Try literal prefix
	elsif (defined ($name = uproot($D->{a},
		$real = subs_dep($D, $norm))))
	{
		$name;
	}
	else {
		die "E: " . ($real ne $I{HAVE}
			# HEY!  The first %q is the symbolic form, and
			# (aka %q) is expanded form.
			? $cs->diag(__('%q: Your HAVE %q (aka %q) is not under ${a} (aka %q)'),
				$apath, $I{HAVE}, $real, $D->{a})
			: $cs->diag(__('%q: Your HAVE %q is not under ${a} (aka %q)'),
				$apath, $I{HAVE}, $D->{a})) . "\n";
	}
}) =~ s/\A\/+//;

#
# Define Template variables (see also Template::Stash
# if you want access to these from a plugin/filter).
#
my %v = (
	D => $D,
	O => $O,
	locate => sub { rewrite(locate($O, $target, @_)); },
	get_version => \&get_version,
	location => $target,
	rewrite => sub {
		@_ == 1 or die Template::Exception->new(usage => "[% rewrite PATH %]");
		goto &rewrite;
	},
);

#
# Specify UTF-8 on both ends of Template Toolkit's I/O:
#
#   * ENCODING for $apath (input), as well as any fetched
#     files via INCLUDE / INSERT / PROCESS / WRAPPER.
#   * binmode for $bpath (output).
#
# By nature of UTF-8, files should be able to round-trip
# as opaque octets... but it's nice to have text decoded
# when you need to do cool stuff with it. ;D
#
# This provider encodes file paths to the system locale,
# and additionally grants access to named dependencies
# that are declared in the same headers siteconf reads.
# Namely, the NEEDs and WANTs are followed recursively
# starting at the SOURCE and added to a whitelist that
# bypasses the regular RELATIVE / ABSOLUTE restrictions.
# This whitelist can be disabled with ALLOW_DEPS => 0.
# You can also require that all file access be declared
# with such a dependency header with CHECK_DEPS => 1,
# in case that helps keeping your templates up-to-date.
#
# By default, any symbolic prefix is permitted, although
# only the standard `${a} ${B}/${b} ${B}/${c}' are tried
# for constructing a plausible symbolic name.  To define
# an explicit whitelist of symbolic prefixes, specify
# ALLOW_PREFIXES.  To have additional prefixes considered
# for a symbolic names, specify PREFIXES.  In both cases
# the list is comprehensive, so it is possible to remove
# a standard prefix by omitting it from the list.
#
# Options are documented in the perldoc of
# RdKw::WwW::GenGenLib::Template::Provider.
#
my $provider = RdKw::WwW::GenGenLib::Template::Provider->new({
	SOURCE => $apath,
	DEFINITION => $D,
	ENCODING => 'UTF-8',
	INCLUDE_PATH => [ '.', $D->{a} ],
})
	or die "[TT] ", RdKw::WwW::GenGenLib::Template::Provider->error(), "\n";
my $tt = Template->new({ LOAD_TEMPLATES => [ $provider ] })
	or die "[TT] ", $Template::ERROR, "\n";

$tt->process($apath, \%v, $cs->to_fs($bpath, { prog => 'E' }),
	{ binmode => ':encoding(UTF-8)' })
	or die "[TT] ", $tt->error(), "\n";

exit 0;  # goodbye!

sub rewrite
{
	my ($christmas) = @_;
	for ($christmas) {
		s{([^/]+)\.html$}
		 {( $1 eq "index" ? "" : $1 )}eig
		if $O->{site_url} =~ m{^https?://}i;
	}
	# merry
		$christmas;
			# ?
}

# Version the built bytes of a declared resource (NEED it in the header):
# get_version('${B}/${b}/x.css'), or as written out.
#
# Peers are OK
sub get_version
{
	@_ == 1 or die Template::Exception->new(usage => "[% get_version(FILE) %]");
	my ($name) = @_;
	my $hash = eval {
		my $path = File::Spec->canonpath(subs_dep($D, $name, strict => 1));
		my $aka = ($name eq $path) ? "" : " (aka `$name')";
		# (as it is, not looked for in INCLUDE_PATH)
		my $error;
		($path, $error) = $provider->access($path);
		defined $error and die "Access denied: $error\n";
		defined $path or die "File `$name'$aka not found\n";
		open my $fh, '<:raw', $cs->to_fs($path, { prog => 'get_version' })
			or die "open `$path' (aka `$name'): $!\n";
		my $digest = Digest::SHA->new(1);
		$digest->addfile($fh);
		close $fh or die "close `$path' (aka `$name'): $!\n";
		(my $hash = $digest->b64digest()) =~ tr'+/='-_.';
		$hash;
	};
	defined $hash or die Template::Exception->new(get_version => $@);
	$hash;
}
