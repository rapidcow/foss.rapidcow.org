+sub rewrite
+{
+	my ($christmas) = @_;
+	for ($christmas) {
+		s{([^/]+)\.html$}
+		 {( $1 eq "index" ? "" : $1 )}eig
+		if $O->{site_url} =~ m{^https?://}i;
+	}
+	# merry
+		$christmas;
+			# ?
+}
+
+# Version the built bytes of a declared resource (NEED it in the header):
+# get_version('${B}/${b}/x.css'), or as written out.
+sub get_version
+{
+	@_ == 1 or die "get_version requires one resource name\n";
+	my ($name) = @_;
+	my $path = File::Spec->canonpath(subs_dep($D, $name));
+	$built eq '.' || index($path, "$built/") == 0
+		or die "get_version: $name is not built (not under \${B}/\${b})\n";
+	# (as it is, not looked for in INCLUDE_PATH)
+	my $error;
+	($path, $error) = $provider->access(
+		File::Spec->file_name_is_absolute($path) ? $path : "./$path");
+	defined $error and die "get_version: $error\n";
+	defined $path or die "get_version: $name is not there\n";
+	open my $fh, '<:raw', $path or die "open $path: $!\n";
+	my $dgst = Digest::SHA->new(1);
+	$dgst->addfile($fh);
+	close $fh or die "close $path: $!\n";
+	my $hash = $dgst->b64digest;
+	$hash =~ tr'+/='-_.';
+	$hash;
+}
